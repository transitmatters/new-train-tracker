{
    "Parameters": {
        "TMFrontendHostname": {
            "Type": "String",
            "Default": "ntt-beta.labs.transitmatters.org",
            "AllowedValues": [
                "traintracker.transitmatters.org",
                "ntt-beta.labs.transitmatters.org"
            ],
            "Description": "The frontend hostname for the new train tracker."
        },
        "TMFrontendZone": {
            "Type": "String",
            "Default": "labs.transitmatters.org",
            "AllowedPattern": "^traintracker\\.transitmatters\\.org$|^labs\\.transitmatters\\.org$",
            "Description": "The frontend's DNS zone file name. Most likely traintracker.transitmatters.org or labs.transitmatters.org."
        },
        "TMBackendZone": {
            "Type": "String",
            "Default": "labs.transitmatters.org",
            "AllowedPattern": "^labs\\.transitmatters\\.org$",
            "Description": "The backend's DNS zone file name. Most likely traintracker.transitmatters.org or labs.transitmatters.org."
        },
        "TMFrontendCertArn": {
            "Type": "String",
            "Description": "The ACM ARN of the frontend certificate."
        },
        "TMBackendHostname": {
            "Type": "String",
            "Default": "ntt-api-beta.labs.transitmatters.org",
            "AllowedPattern": "^.*\\.labs\\.transitmatters\\.org$",
            "Description": "The backend hostname for the new train tracker."
        },
        "TMBackendCertArn": {
            "Type": "String",
            "Description": "The ACM ARN of the backend certificate."
        },
        "MbtaV3ApiKey": {
            "Type": "String",
            "Description": "MBTA V3 API key."
        },
        "DDApiKey": {
            "Type": "String",
            "Description": "Datadog API key."
        },
        "DDTags": {
            "Type": "String",
            "Description": "Additional Datadog Tags"
        },
        "GitVersion": {
            "Type": "String",
            "Description": "Current Git Id"
        }
    },
    "Resources": {
        "ApiGatewayCustomDomain": {
            "Type": "AWS::ApiGateway::DomainName",
            "Properties": {
                "RegionalCertificateArn": { "Ref": "TMBackendCertArn" }
            }
        },
        "FrontendDNSRecordSet": {
            "Type": "AWS::Route53::RecordSet",
            "Properties": {
                "Name": { "Ref": "TMFrontendHostname" },
                "HostedZoneName": { "Fn::Sub": "${TMFrontendZone}." },
                "AliasTarget": {
                    "HostedZoneId": "Z2FDTNDATAQYW2",
                    "DNSName": {
                        "Fn::GetAtt": ["FrontendCloudFront", "DomainName"]
                    }
                },
                "Type": "A"
            }
        },
        "BackendDNSRecordSet": {
            "Type": "AWS::Route53::RecordSet",
            "Properties": {
                "Name": { "Ref": "TMBackendHostname" },
                "HostedZoneName": { "Fn::Sub": "${TMBackendZone}." },
                "AliasTarget": {
                    "HostedZoneId": "Z2FDTNDATAQYW2",
                    "DNSName": {
                        "Fn::GetAtt": ["BackendCloudFront", "DomainName"]
                    }
                },
                "Type": "A"
            }
        },
        "APIHandler": {
            "Type": "AWS::Serverless::Function",
            "Properties": {
                "Description": "API handler for new train tracker. This is the backend for the app.",
                "Handler": "datadog_lambda.handler.handler",
                "Environment": {
                    "Variables": {
                        "MBTA_V3_API_KEY": { "Ref": "MbtaV3ApiKey" },
                        "DD_API_KEY": { "Ref": "DDApiKey" },
                        "DD_VERSION": { "Ref": "GitVersion" },
                        "DD_TAGS": { "Ref": "DDTags" }
                    }
                }
            }
        },
        "UpdateLastSeen": {
            "Type": "AWS::Serverless::Function",
            "Properties": {
                "Description": "Update the last seen time for new trains on a schedule",
                "Environment": {
                    "Variables": {
                        "MBTA_V3_API_KEY": { "Ref": "MbtaV3ApiKey" },
                        "DD_API_KEY": { "Ref": "DDApiKey" },
                        "DD_VERSION": { "Ref": "GitVersion" },
                        "DD_TAGS": { "Ref": "DDTags" }
                    }
                }
            }
        },
        "FrontendBucket": {
            "Type": "AWS::S3::Bucket",
            "Properties": {
                "PublicAccessBlockConfiguration": {
                    "BlockPublicPolicy": false,
                    "RestrictPublicBuckets": false
                },
                "BucketName": { "Ref": "TMFrontendHostname" },
                "WebsiteConfiguration": {
                    "IndexDocument": "index.html",
                    "ErrorDocument": "index.html"
                },
                "LifecycleConfiguration": {
                    "Rules": [
                        {
                            "Id": "ArchiveOldObjects",
                            "Status": "Enabled",
                            "Transitions": [
                                {
                                    "StorageClass": "INTELLIGENT_TIERING",
                                    "TransitionInDays": 90
                                }
                            ],
                            "ExpirationInDays": 120
                        }
                    ]
                },
                "Tags": [
                    {
                        "Key": "service",
                        "Value": "new-train-tracker"
                    }
                ]
            }
        },
        "FrontendBucketPolicy": {
            "Type": "AWS::S3::BucketPolicy",
            "Properties": {
                "Bucket": { "Ref": "FrontendBucket" },
                "PolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Sid": "PublicReadForGetBucketObjects",
                            "Effect": "Allow",
                            "Principal": "*",
                            "Action": "s3:GetObject",
                            "Resource": {
                                "Fn::Join": [
                                    "",
                                    [{ "Fn::GetAtt": ["FrontendBucket", "Arn"] }, "/*"]
                                ]
                            }
                        }
                    ]
                }
            }
        },
        "ApiGatewayCustomDomainMapping": {
            "Type": "AWS::ApiGateway::BasePathMapping",
            "Properties": {
                "RestApiId": { "Ref": "RestAPI" },
                "Stage": { "Ref": "RestAPI.Stage" }
            }
        },
        "RestAPI": {
            "Type": "AWS::Serverless::Api",
            "Properties": {
                "DefinitionBody": {
                    "info": {
                        "title": { "Ref": "TMBackendHostname" }
                    }
                }
            }
        },
        "BackendCachePolicy": {
            "Type": "AWS::CloudFront::CachePolicy",
            "Properties": {
                "CachePolicyConfig": {
                    "Name": { "Fn::Sub": "${AWS::StackName}-api-origin-ttl" },
                    "Comment": "Cache API responses only as long as their Cache-Control allows; responses without one are not cached",
                    "MinTTL": 0,
                    "DefaultTTL": 0,
                    "MaxTTL": 604800,
                    "ParametersInCacheKeyAndForwardedToOrigin": {
                        "CookiesConfig": { "CookieBehavior": "none" },
                        "HeadersConfig": { "HeaderBehavior": "none" },
                        "QueryStringsConfig": { "QueryStringBehavior": "none" },
                        "EnableAcceptEncodingGzip": true,
                        "EnableAcceptEncodingBrotli": true
                    }
                }
            }
        },
        "BackendRefererCheck": {
            "Type": "AWS::CloudFront::Function",
            "Properties": {
                "Name": { "Fn::Sub": "${AWS::StackName}-api-referer-check" },
                "AutoPublish": true,
                "FunctionConfig": {
                    "Comment": "Reject API requests that don't come from the frontend",
                    "Runtime": "cloudfront-js-2.0"
                },
                "FunctionCode": {
                    "Fn::Sub": "function handler(event) {\n    var request = event.request;\n    if (request.uri === '/healthcheck') {\n        return request;\n    }\n    var allowed = 'https://${TMFrontendHostname}';\n    var origin = request.headers.origin ? request.headers.origin.value : '';\n    var referer = request.headers.referer ? request.headers.referer.value : '';\n    if (origin === allowed || referer === allowed || referer.indexOf(allowed + '/') === 0) {\n        return request;\n    }\n    return { statusCode: 403, statusDescription: 'Forbidden' };\n}\n"
                }
            }
        },
        "BackendCloudFront": {
            "Type": "AWS::CloudFront::Distribution",
            "Properties": {
                "DistributionConfig": {
                    "Aliases": [{ "Ref": "TMBackendHostname" }],
                    "Comment": "Shared edge cache in front of the API to cut Lambda invocations",
                    "Enabled": true,
                    "HttpVersion": "http2and3",
                    "DefaultCacheBehavior": {
                        "TargetOriginId": "api-gateway",
                        "ViewerProtocolPolicy": "redirect-to-https",
                        "AllowedMethods": ["GET", "HEAD", "OPTIONS"],
                        "CachedMethods": ["GET", "HEAD"],
                        "Compress": true,
                        "CachePolicyId": { "Ref": "BackendCachePolicy" },
                        "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
                        "FunctionAssociations": [
                            {
                                "EventType": "viewer-request",
                                "FunctionARN": {
                                    "Fn::GetAtt": ["BackendRefererCheck", "FunctionMetadata.FunctionARN"]
                                }
                            }
                        ]
                    },
                    "Origins": [
                        {
                            "Id": "api-gateway",
                            "DomainName": {
                                "Fn::Sub": "${RestAPI}.execute-api.${AWS::Region}.amazonaws.com"
                            },
                            "OriginPath": {
                                "Fn::Join": ["", ["/", { "Ref": "RestAPI.Stage" }]]
                            },
                            "CustomOriginConfig": {
                                "HTTPSPort": 443,
                                "OriginProtocolPolicy": "https-only",
                                "OriginSSLProtocols": ["TLSv1.2"]
                            }
                        }
                    ],
                    "CustomErrorResponses": [
                        { "ErrorCode": 500, "ErrorCachingMinTTL": 0 },
                        { "ErrorCode": 502, "ErrorCachingMinTTL": 0 },
                        { "ErrorCode": 503, "ErrorCachingMinTTL": 0 },
                        { "ErrorCode": 504, "ErrorCachingMinTTL": 0 }
                    ],
                    "PriceClass": "PriceClass_100",
                    "ViewerCertificate": {
                        "MinimumProtocolVersion": "TLSv1.2_2021",
                        "AcmCertificateArn": { "Ref": "TMBackendCertArn" },
                        "SslSupportMethod": "sni-only"
                    }
                },
                "Tags": [
                    {
                        "Key": "service",
                        "Value": "new-train-tracker"
                    }
                ]
            }
        },
        "FrontendCloudFront": {
            "Type": "AWS::CloudFront::Distribution",
            "Properties": {
                "DistributionConfig": {
                    "Aliases": [{ "Ref": "TMFrontendHostname" }],
                    "Enabled": "true",
                    "DefaultCacheBehavior": {
                        "Compress": true,
                        "ForwardedValues": {
                            "QueryString": "false"
                        },
                        "TargetOriginId": "only-origin",
                        "ViewerProtocolPolicy": "redirect-to-https"
                    },
                    "DefaultRootObject": "index.html",
                    "Origins": [
                        {
                            "CustomOriginConfig": {
                                "HTTPPort": "80",
                                "HTTPSPort": "443",
                                "OriginProtocolPolicy": "http-only"
                            },
                            "DomainName": {
                                "Fn::Join": [
                                    "",
                                    [
                                        { "Ref": "TMFrontendHostname" },
                                        ".s3-website-us-east-1.amazonaws.com"
                                    ]
                                ]
                            },
                            "Id": "only-origin"
                        }
                    ],
                    "CustomErrorResponses": [
                        {
                            "ErrorCode": "404",
                            "ResponsePagePath": "/index.html",
                            "ResponseCode": "404",
                            "ErrorCachingMinTTL": "86400"
                        }
                    ],
                    "PriceClass": "PriceClass_100",
                    "ViewerCertificate": {
                        "MinimumProtocolVersion": "TLSv1.2_2018",
                        "AcmCertificateArn": { "Ref": "TMFrontendCertArn" },
                        "SslSupportMethod": "sni-only"
                    }
                },
                "Tags": [
                    {
                        "Key": "service",
                        "Value": "new-train-tracker"
                    }
                ]
            }
        }
    },
    "Outputs": {
        "WebsiteURL": {
            "Value": "FrontendBucket.WebsiteURL",
            "Description": "URL for website hosted on S3"
        }
    }
}
