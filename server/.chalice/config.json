{
  "version": "2.0",
  "app_name": "new-train-tracker",
  "lambda_architecture": "arm64",
  "api_gateway_endpoint_type": "REGIONAL",
  "minimum_compression_size": 1000,
  "lambda_timeout": 30,
  "lambda_memory_size": 220,
  "layers": [
    "arn:aws:lambda:us-east-1:464622532012:layer:Datadog-Extension-ARM:101"
  ],
  "stages": {
    "production": {
      "api_gateway_stage": "production",
      "lambda_functions": {
        "api_handler": {
          "lambda_timeout": 10
        }
      },
      "autogen_policy": false,
      "iam_policy_file": "policy.json",
      "environment_variables": {
        "DD_LAMBDA_HANDLER": "app.app",
        "DD_SERVICE": "new-train-tracker",
        "DD_SERVICE_MAPPING": "lambda_api_gateway:new-train-tracker",
        "DD_SITE": "datadoghq.com",
        "DD_TRACE_ENABLED": "true",
        "DD_PROFILING_ENABLED": "true",
        "DD_ENV": "prod",
        "TM_CORS_HOST": "traintracker.transitmatters.org",
        "PRIDE_TRAIN_CARS": "3706",
        "HOLIDAY_TRAIN_CARS": "1410,1411,1462,1463,1502,1503,1938,1939,1940,1941,1962,1963,0700,0701,0714,0715,0762,0763,3704,3875"
      },
      "tags": {
        "service": "new-train-tracker",
        "env": "prod"
      },
      "api_gateway_custom_domain": {
        "domain_name": "traintracker-api.labs.transitmatters.org",
        "tls_version": "TLS_1_2",
        "certificate_arn": ""
      }
    },
    "beta": {
      "api_gateway_stage": "beta",
      "lambda_functions": {
        "api_handler": {
          "lambda_timeout": 10
        }
      },
      "autogen_policy": false,
      "iam_policy_file": "policy-beta.json",
      "environment_variables": {
        "DD_LAMBDA_HANDLER": "app.app",
        "DD_SERVICE": "new-train-tracker",
        "DD_SERVICE_MAPPING": "lambda_api_gateway:new-train-tracker",
        "DD_SITE": "datadoghq.com",
        "DD_TRACE_ENABLED": "true",
        "DD_PROFILING_ENABLED": "true",
        "DD_ENV": "beta",
        "TM_CORS_HOST": "ntt-beta.labs.transitmatters.org",
        "PRIDE_TRAIN_CARS": "3706",
        "HOLIDAY_TRAIN_CARS": "1410,1411,1462,1463,1502,1503,1938,1939,1940,1941,1962,1963,0700,0701,0714,0715,0762,0763,3704,3875"
      },
      "tags": {
        "service": "new-train-tracker",
        "env": "beta"
      },
      "api_gateway_custom_domain": {
        "domain_name": "ntt-api-beta.labs.transitmatters.org",
        "tls_version": "TLS_1_2",
        "certificate_arn": ""
      }
    }
  }
}
